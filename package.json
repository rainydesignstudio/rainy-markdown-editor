{
  "name": "rainy-markdown-editor",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack -p 3500",
    "predev": "node scripts/generate-format-assets.mjs",
    "prebuild": "node scripts/generate-tailwind-assets.mjs && node scripts/generate-format-assets.mjs",
    "build": "next build --webpack",
    "start": "node scripts/start-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs --test tests/**/*.test.mjs"
  },
  "dependencies": {
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "decode-named-character-reference": "1.3.0",
    "dompurify": "3.4.14",
    "fflate": "0.8.2",
    "html-to-image": "1.11.13",
    "i18next": "26.4.2",
    "inline-style-parser": "0.2.7",
    "jspdf": "3.0.0",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "mp-darkmode": "1.2.3-alpha.1",
    "next": "16.3.4",
    "parse5": "7.3.0",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-syntax-highlighter": "15.5.13",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
